# No-Docker local/server deployment
APP_ENV=production
API_SECRET_KEY=change-me-long-random-secret
# Option A: SQLite quick start (single machine)
DATABASE_URL=sqlite:///./citrisurksha.db
# Option B: PostgreSQL native install
# DATABASE_URL=postgresql+psycopg2://citrisurksha:strongpassword@127.0.0.1:5432/citrisurksha
REDIS_URL=redis://127.0.0.1:6379/0
AI_SERVICE_URL=http://127.0.0.1:8100
UPLOAD_DIR=./storage/uploads
FORCE_CPU=true
TORCH_NUM_THREADS=8
PEST_CONFIDENCE_THRESHOLD=0.55
STRICT_20_CLASS_TRAINING=true
MIN_IMAGES_PER_PEST=1
MODEL_STORE=./ai-service/model-store

# --- Multi-stage AI pipeline (upgrade step 2) ---
AI_ENGINE=legacy
YOLO_WEIGHTS=
YOLO_MODEL=yolo11s.pt
YOLO_IMGSZ=640
YOLO_CONF=0.25
YOLO_IOU=0.45
YOLO_DEVICE=cpu
YOLO_BATCH=1
DETECTOR_TILING=true
DETECTOR_TILE_TRIGGER=1600
DECIDE_IDENTIFY_MIN=0.65
DECIDE_MARGIN_MIN=0.08
DECIDE_NEGATIVE_MIN=0.60
DECIDE_SUPPORT_MIN=1
W_YOLO=0.45
W_CNN=0.25
W_DINO=0.20
W_CLIP=0.10

# --- Visual memory (upgrade step 4): DINOv2 embeddings + Qdrant ---
DINOV2_ENABLED=true
#DINO_HUB_DIR=/path/to/torch-hub-cache
# Leave empty for embedded local Qdrant (model-store/qdrant); set for a server.
QDRANT_PATH=
#QDRANT_URL=http://localhost:6333
#QDRANT_API_KEY=
MEMORY_ENABLED=true
MEMORY_TOP_K=8
DINO_MIN_SIM=0.25

# --- OpenCLIP secondary signal (upgrade step 5) ---
CLIP_ENABLED=true
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai
# Optional per-pest prompt overrides JSON (see ai-service/config/clip_prompts.json)
CLIP_PROMPTS_FILE=

# --- Model governance (upgrade step 7) ---
# Training NEVER auto-activates; deployment is explicit (admin deploy/rollback).
AUTO_ACTIVATE_TRAINING=false

# --- Frozen-test comparison gate (upgrade step 8) ---
COMPARE_MAX_DROP=0.05
COMPARE_EPS=0.01

# --- Optional MLflow tracking (upgrade step 9) - never required for inference ---
MLFLOW_ENABLED=false
# Self-hosted: e.g. http://localhost:5000 or sqlite:///mlflow.db
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=citrisurksha-training
