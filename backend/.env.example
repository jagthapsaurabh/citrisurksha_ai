# Backend-specific env file. Works when running directly from backend folder.
# You can also keep these values in ../.env at project root.

APP_ENV=development
API_SECRET_KEY=change-me-long-random-secret

# Recommended direct no-Docker Windows PostgreSQL URL:
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/citrisurksha

# Alternative DB_* style if DATABASE_URL is absent:
# DB_DRIVER=postgresql+psycopg2
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=citrisurksha
# DB_USER=postgres
# DB_PASSWORD=YOUR_PASSWORD

# If DATABASE_URL still has Docker hostname @postgres, backend auto-converts to @localhost outside Docker.
AUTO_LOCALHOST_DB_FALLBACK=true

REDIS_URL=redis://localhost:6379/0
AI_SERVICE_URL=http://localhost:8100
UPLOAD_DIR=../storage/uploads
FIREBASE_SERVICE_ACCOUNT_PATH=./app/firebase-service-account.json
