APP_ENV=production
API_SECRET_KEY=CHANGE_TO_LONG_RANDOM_SECRET

# PostgreSQL on VPS or managed PostgreSQL
DATABASE_URL=postgresql+psycopg2://DB_USER:DB_PASSWORD@127.0.0.1:5432/citrisurksha
AUTO_LOCALHOST_DB_FALLBACK=true

# Redis installed on VPS. If not available, backend falls back to memory cache, but Redis is recommended.
REDIS_URL=redis://127.0.0.1:6379/0

# AI service on same VPS. If you host AI separately, change this URL.
AI_SERVICE_URL=http://127.0.0.1:8100

# Uploads and Firebase service account on VPS
UPLOAD_DIR=/var/www/citrisurksha/storage/uploads
FIREBASE_SERVICE_ACCOUNT_PATH=/var/www/citrisurksha/backend/app/firebase-service-account.json

ACCESS_TOKEN_MINUTES=10080
