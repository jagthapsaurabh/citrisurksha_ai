[Unit]
Description=CitriSurksha Backend API
After=network.target postgresql.service redis-server.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/citrisurksha
EnvironmentFile=/var/www/citrisurksha/.env
ExecStart=/var/www/citrisurksha/.venv-api/bin/uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
